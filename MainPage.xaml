<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chess.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Padding="30,0"
            Spacing="25">
            <Image
                Source="chessnotcom.png"
                HeightRequest="185"
                Aspect="AspectFit"
                SemanticProperties.Description="dot net bot in a submarine number ten" />

            <Label
                Text="Приветствуем в наших шахматах"
                FontSize="30"
                Style="{StaticResource Headline}"
                SemanticProperties.HeadingLevel="Level9" />
            <VerticalStackLayout Spacing="-20">
                <Label Text="Chess" 
                           FontSize="60"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level1" />
                <HorizontalStackLayout Spacing="9" HorizontalOptions="Center">
                    <Label Text=" not " TextColor="Red" 
                           FontAttributes="Italic"
                           FontSize="40"
                           Style="{StaticResource Headline}"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="com" 
                           FontAttributes="Italic"
                           FontSize="40"
                           Style="{StaticResource Headline}" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
            <Button
                Text="Новая игра" 
                SemanticProperties.Hint="Counts the number of times you click"
                HorizontalOptions="Center"
                WidthRequest="300"/>
            <Button
                Text="Продолжить игру" 
                SemanticProperties.Hint="Counts the number of times you click"
                HorizontalOptions="Center"
                WidthRequest="300"/>
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
