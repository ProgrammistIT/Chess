<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chess.Debug">
    <ContentPage.Content>
        <VerticalStackLayout
            Padding="30,50"
            Spacing="25">
            <Button 
                x:Name="OpenFolder"
                Text="Открыть папку"
                HorizontalOptions="Center"
                WidthRequest="500"
                Clicked="OpenFolder_Clicked"/>
            <Button
                x:Name="OpenNewWindow"
                Text="Открыть новое окно"
                HorizontalOptions="Center"
                WidthRequest="500"
                Clicked="OpenNewWindow_OnClicked"
            />
            <Button
                x:Name="DelFiles"
                Text="Удалить старые файлы"
                HorizontalOptions="Center"
                WidthRequest="500"
                Clicked="DelFiles_OnClicked"
                />
            
            
            <Button
                x:Name="CloseDebug"
                Text="Закрыть окно дебага"
                HorizontalOptions="Center"
                WidthRequest="300"
                Clicked="CloseDebug_OnClicked"
                />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>