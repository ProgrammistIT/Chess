<?xml version="1.0" encoding="utf-8"?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Chess.GamePage">
    <ContentPage.Content>
        <VerticalStackLayout>
            <Label  Text="White Turn"
                    FontSize="30"
                    HorizontalOptions="Center"
                    x:Name="Title_Game"/>
        
            <Border Stroke="Gray"   
                    StrokeThickness="1"
                    HeightRequest="400"
                    WidthRequest="400"
                    HorizontalOptions="Center"
                />
            <Button Text="Back"
                    x:Name="Back"
                    Clicked="Back_OnClicked"
                    HorizontalOptions="Center"
                    WidthRequest="200"
                    />
        </VerticalStackLayout>
    </ContentPage.Content>
</ContentPage>